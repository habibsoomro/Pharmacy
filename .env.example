# Copy this file to .env.local and fill in your values.
# .env.local is ignored by git, so your key never leaves your computer/server.

# Your Anthropic API key (https://console.anthropic.com). Server-side only.
ANTHROPIC_API_KEY=

# Shared rate limits (strongly recommended on Vercel). Free tier at https://upstash.com:
# create a Redis database, then copy its "REST URL" and "REST TOKEN" here.
# Without these, each server instance counts visitors on its own (weaker online).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: any long random text. Used to scramble visitors' internet addresses
# before counting them, so real addresses are never stored.
# RATE_LIMIT_SALT=

# Optional: the most AI requests the whole website may make per day (scans,
# safety checks and translations together), to protect your Anthropic bill.
# Leave empty for no daily limit. Example: 500
# AI_DAILY_LIMIT=

# Test mode: set to 1 to try the whole app WITHOUT calling the AI
# (always returns the same sample prescription). Never use on the live site.
# AI_MOCK=1
